PROVIDER_DEFAULTS = {
    "gemini": ("gemini-1.5-flash", None),
    "ollama": ("llama3", None),
    "openai": ("gpt-4o-mini", "https://api.openai.com/v1"),
    "copilot": ("openai/gpt-4o-mini", "https://models.github.ai/inference"),
    "claude": ("claude-3-5-sonnet-latest", "https://api.anthropic.com"),
}


class ProviderError(RuntimeError):
    """Raised when an AI provider cannot return a usable response."""


def _request_json(method, url, **kwargs):
    last_error = None
    for attempt in range(MAX_RETRIES):
        try:
            request = requests.post if method.upper() == "POST" else requests.request
            response = request(url, timeout=REQUEST_TIMEOUT, **kwargs)
            status_code = getattr(response, "status_code", 200)
            if isinstance(status_code, int) and (
                status_code == 429 or status_code >= 500
            ):
                if attempt < MAX_RETRIES - 1:
                    sleep(2**attempt)
                    continue
            response.raise_for_status()
            return response.json()
        except (requests.exceptions.RequestException, ValueError) as error:
            last_error = error
            if attempt < MAX_RETRIES - 1:
                sleep(2**attempt)
    raise ProviderError(f"AIプロバイダへの通信に失敗しました: {last_error}")


def ask_gemini(text, system_prompt, api_key, model_name="gemini-1.5-flash"):
    if not api_key:
        raise ProviderError("Gemini APIキーが設定されていません。")
    try:
        genai.configure(api_key=api_key)
        model = genai.GenerativeModel(model_name, system_instruction=system_prompt)
        response = model.generate_content(text)
        result = getattr(response, "text", None)
        if not result:
            raise ProviderError("Geminiの応答が空です。")
        return result
    except ProviderError:
        raise
    except Exception as error:
        raise ProviderError(f"Geminiでの生成に失敗しました: {error}") from error


def ask_ollama(text, system_prompt, model_name="llama3"):
    url = "http://localhost:11434/api/generate"
    payload = {
        "model": model_name,
        "prompt": f"{system_prompt}\n\n対象の文章:\n{text}",
        "stream": False,
    }
    try:
        response_data = _request_json("POST", url, json=payload)
        ollama_response = response_data.get("response")
        if not ollama_response:
            return "Ollamaの応答形式が不正です。'response' フィールドが見つかりません。"
        return ollama_response
    except ProviderError as error:
        return f"Ollamaとの通信に失敗しました。Ollamaが起動しているか確認してください。\nError: {error}"


def ask_openai_compatible(
    text, system_prompt, api_key, model_name, base_url, provider_name="OpenAI"
):
    if not api_key:
        raise ProviderError(f"{provider_name} APIキーが設定されていません。")
    response_data = _request_json(
        "POST",
        f"{base_url.rstrip('/')}/chat/completions",
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
        json={
            "model": model_name,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": text},
            ],
        },
    )
    try:
        result = response_data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError) as error:
        raise ProviderError(f"{provider_name}の応答形式が不正です。") from error
    if not result:
        raise ProviderError(f"{provider_name}の応答が空です。")
    return result


def ask_claude(text, system_prompt, api_key, model_name="claude-3-5-sonnet-latest"):
    if not api_key:
        raise ProviderError("Claude APIキーが設定されていません。")
    response_data = _request_json(
        "POST",
        "https://api.anthropic.com/v1/messages",
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
        json={
            "model": model_name,
            "max_tokens": 1024,
            "system": system_prompt,
            "messages": [{"role": "user", "content": text}],
        },
    )
    try:
        result = response_data["content"][0]["text"]
    except (KeyError, IndexError, TypeError) as error:
        raise ProviderError("Claudeの応答形式が不正です。") from error
    if not result:
        raise ProviderError("Claudeの応答が空です。")
    return result


def _read_target_text():
    console.print(
        "\n[bold green]攻撃対象の文章を入力してください（空行で終了）:[/bold green]"
    )
    lines = []
    try:
        while True:
            line = input()
            if not line:
                break
            lines.append(line)
    except (EOFError, KeyboardInterrupt):
        console.print("\n[yellow]入力をキャンセルしました。[/yellow]")
        return ""
    return "\n".join(lines).strip()


def _select_provider():
    provider = Prompt.ask(
        "使用するAIプラットフォームを選択してください",
        choices=list(PROVIDER_DEFAULTS),
        default="ollama",
    )
    default_model, default_url = PROVIDER_DEFAULTS[provider]
    env_key = {
        "gemini": "GEMINI_API_KEY",
        "openai": "OPENAI_API_KEY",
        "claude": "ANTHROPIC_API_KEY",
        "copilot": "GITHUB_TOKEN",
    }.get(provider)
    api_key = os.environ.get(env_key, "") if env_key else ""
    if provider != "ollama" and not api_key:
        api_key = Prompt.ask(f"{provider} APIキー/トークンを入力してください", password=True)
    model = Prompt.ask("モデル名", default=default_model)
    base_url = default_url
    if provider in ("openai", "copilot"):
        base_url = Prompt.ask("APIベースURL", default=default_url)
    return provider, api_key, model, base_url


def _ask_provider(provider, text, system_prompt, api_key, model, base_url):
    if provider == "gemini":
        return ask_gemini(text, system_prompt, api_key, model)
    if provider == "ollama":
        return ask_ollama(text, system_prompt, model)
    if provider == "claude":
        return ask_claude(text, system_prompt, api_key, model)
    return ask_openai_compatible(
        text, system_prompt, api_key, model, base_url, provider.title()
    )


def _save_results(results, provider, model):
    filename = Prompt.ask("保存先ファイル名", default="antagon-result.md")
    output = [
        "# Antagon Red Teaming Result",
        "",
        f"- Generated: {datetime.now().astimezone().isoformat(timespec='seconds')}",
        f"- Provider: {provider}",
        f"- Model: {model}",
        "",
    ]
    for agent_name, agent_data, result in results:
        output.extend(
            [
                f"## {agent_data['role']}",
                "",
                result,
                "",
            ]
        )
    Path(filename).write_text("\n".join(output), encoding="utf-8")
    console.print(f"[green]結果を {filename} に保存しました。[/green]")


def main():
    console.print(
        Panel.fit("[bold red]Antagon 🎭[/bold red]\n[italic]Your Personal Devil's Advocate[/italic]")
    )
    provider, api_key, model, base_url = _select_provider()
    target_text = _read_target_text()
    if not target_text:
        console.print("[red]テキストが入力されていません。終了します。[/red]")
        return

    console.print("\n[bold red]💥 Multi-Agent Red Teaming Initiated...[/bold red]")
    results = [None] * len(AGENTS)
    with Progress() as progress:
        tasks = {
            name: progress.add_task(
                f"[bold {data['color']}] {data['role']} が解析中...", total=100
            )
            for name, data in AGENTS.items()
        }
        with ThreadPoolExecutor(max_workers=len(AGENTS)) as executor:
            futures = {
                executor.submit(
                    _ask_provider,
                    provider,
                    target_text,
                    data["prompt"],
                    api_key,
                    model,
                    base_url,
                ): (index, name, data)
                for index, (name, data) in enumerate(AGENTS.items())
            }
            for future in as_completed(futures):
                index, name, data = futures[future]
                try:
                    result = future.result()
                except Exception as error:
                    result = f"[red]このエージェントは失敗しました: {error}[/red]"
                results[index] = (name, data, result)
                progress.update(tasks[name], completed=100)

    for _, agent_data, result in results:
        console.print(
            Panel(
                Markdown(result),
                title=f"[bold {agent_data['color']}]{agent_data['role']}[/bold {agent_data['color']}]",
                border_style=agent_data["color"],
            )
        )
    if Confirm.ask("結果をMarkdownファイルに保存しますか？", default=True):
        _save_results(results, provider, model)


if __name__ == "__main__":
    main()
